<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Relative local feed for pinned Sonora packages (populate .sonora-packages/; gitignored). -->
    <add key="sonora-local" value="./.sonora-packages" />
  </packageSources>
</configuration>
